{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "declaration-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ]
      }
    ],
    "at-rule-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ]
      }
    ],
    "comment-empty-line-before": [
      "always",
      {
        "except": [
          "first-nested"
        ]
      }
    ],
    "max-nesting-depth": 3,
    "selector-pseudo-element-no-unknown": true,
    "property-no-unknown": true
  },
  "ignoreFiles": [
    "dist/**",
    "node_modules/**"
  ]
}
